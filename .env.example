DB_PASSWORD=replace-with-a-strong-database-password
DB_ROOT_PASSWORD=replace-with-a-different-root-password
JWT_SECRET=replace-with-at-least-32-random-characters
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=
APP_ORIGIN=http://localhost:3000
JPA_DDL_AUTO=update
# Daily compressed database backups, retaining 14 days in the database-backups volume.
BACKUP_INTERVAL_SECONDS=86400
BACKUP_RETENTION_DAYS=14
MAIL_LOG_LINKS=true
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=your-smtp-username
MAIL_PASSWORD=your-smtp-password
MAIL_FROM=no-reply@example.com
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS=true
# Production TURN example (set at frontend build time):
# VITE_ICE_SERVERS=[{"urls":"turn:turn.example.com:3478","username":"user","credential":"secret"}]
